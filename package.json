{
  "name": "browser-ai",
  "private": true,
  "version": "1.0.0",
  "description": "A private, adaptive, voice-enabled AI companion that runs entirely in your browser.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/copy-ort-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ort-assets.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "copy:ort": "node scripts/copy-ort-assets.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@tailwindcss/vite": "^4.3.5",
    "onnxruntime-web": "^1.31.1",
    "phonemizer": "^1.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.3.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.2"
  }
}
